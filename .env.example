# This application is intentionally single-user and loopback-only.
FIND_FACE_PORT=8765
# Optional: configure Google OAuth in the web interface instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# buffalo_sc: lightweight CPU model (~15 MB), buffalo_l: larger model (~281 MB).
FIND_FACE_MODEL=buffalo_sc
# Optional, absolute directory containing a licensed InsightFace model pack.
FIND_FACE_MODEL_DIR=
